{
  "manifest_version": 3,
  "name": "КриптоПро через Рутокен",
  "description": "Сайты, рассчитанные на КриптоПро ЭЦП Browser plug-in, работают через Рутокен Плагин.",
  "version": "0.0.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "КриптоПро через Рутокен",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
