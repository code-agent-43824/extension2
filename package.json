{
  "name": "extension2",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "node scripts/package.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src && tsc --noEmit -p src/extension",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "stand": "node scripts/fetch-vendor.ts && node scripts/setup-stand.ts && node scripts/provision-token.ts",
    "test:stand": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
