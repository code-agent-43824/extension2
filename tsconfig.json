{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "xmldsigjs-canonicalizer": ["./node_modules/xmldsigjs/build/esm/canonicalizer.js"]
    }
  },
  "include": [
    "scripts",
    "tests",
    "*.config.ts",
    "src/page/globals.d.ts"
  ]
}
